# New split installations use scripts/Setup Echo.command and private per-user files in:
# ~/Library/Application Support/Echo/{settings.json,.env,mcp.json}
# This file supports manual/legacy setup. Never commit a real .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Main-login always-on service. Put changes in its private .env, then restart it.
OPENAI_PLANNER_MODEL=gpt-4.1
OPENAI_WORKER_MODEL=gpt-4.1-mini
# Optional: defaults to the worker model. Handles conversation and routes tool work.
OPENAI_CONVERSATION_MODEL=gpt-4.1-mini
OPENAI_NOTIFICATION_MODEL=gpt-4.1-mini
ECHO_MAX_ROUNDS=8
ECHO_MAX_TOOL_CALLS=12
ECHO_TASK_SECONDS=600
ECHO_JOB_WATCH_SECONDS=7200
ECHO_TASK_TOKEN_LIMIT=64000
ECHO_DAILY_TOKEN_LIMIT=250000

# Optional USD cap: disabled at 0. Set your own cap and verified USD / 1M token
# input/output rates for EVERY selected model before enabling it. Never guess rates.
# Example shape only: {"your-model":{"input":VERIFIED_RATE,"output":VERIFIED_RATE}}
ECHO_DAILY_USD_LIMIT=0
ECHO_MODEL_PRICES={}

# Optional local Codex worker workspace; keep outside the deployed Echo checkout.
ECHO_CODEX_WORKSPACE=~/EchoWorkspace

# Legacy single-login mode only (split mode checks owner in settings.json).
ECHO_MCP_ENABLED=0
ECHO_TOOL_OWNER=+19089691989

# Optional legacy BlueBubbles transport. Unused by the split Messages bridge.
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_SEND_METHOD=apple-script
HOST=127.0.0.1
PORT=8000
