# BlueBubbles Server's local HTTP address and configured server password.
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=replace-with-your-server-password
# Basic text sends work without Private API. Use private-api only if configured.
BLUEBUBBLES_SEND_METHOD=apple-script
# Keep the unauthenticated webhook on the same Mac as BlueBubbles.
HOST=127.0.0.1
PORT=8000

# Required for both direct Mac and BlueBubbles modes. Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local MCP tools. Only this exact sender may use them.
ECHO_MCP_ENABLED=0
ECHO_TOOL_OWNER=+19089691989
# Separate working folder for Codex; never use the running Echo checkout.
ECHO_CODEX_WORKSPACE=~/EchoWorkspace
